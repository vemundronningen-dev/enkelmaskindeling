generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MachineStatus {
  LEDIG
  TILDELT
  BOOKET
  I_BRUK
  SERVICE
  UTE_AV_DRIFT
}

enum BookingStatus {
  PLANLAGT
  AKTIV
  FULLFORT
  KANSELLERT
}

enum UserRole {
  ADMIN
  USER
}

model Company {
  id          String      @id @default(cuid())
  name        String      @unique
  orgNumber   String?     @unique
  departments Department[]
  projects    Project[]
  machines    Machine[]
  users       User[]
  bookings    MachineBooking[]
  statusLogs  MachineStatusLog[]
  locationHistory MachineLocationHistory[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Department {
  id          String    @id @default(cuid())
  name        String
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users       User[]
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([companyId, name])
}

model Project {
  id           String      @id @default(cuid())
  name         String
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  machines     Machine[]
  bookings     MachineBooking[]
  locationHistory MachineLocationHistory[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([companyId, name])
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  phone        String?
  passwordHash String
  role         UserRole    @default(USER)
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  sessions     Session[]
  machines     Machine[]   @relation("ResponsibleUserMachines")
  responsibleBookings MachineBooking[] @relation("BookingResponsibleUser")
  locationAssignments MachineLocationHistory[] @relation("LocationResponsibleUser")
  createdBookings MachineBooking[] @relation("BookingCreatedBy")
  updatedBookings MachineBooking[] @relation("BookingUpdatedBy")
  createdStatusLogs MachineStatusLog[] @relation("StatusLogCreatedBy")
  createdLocationLogs MachineLocationHistory[] @relation("LocationLogCreatedBy")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Machine {
  id                String        @id @default(cuid())
  name              String
  machineNumber     String        @unique
  type              String
  companyId         String
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project           String
  projectId         String?
  projectRef        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  status            MachineStatus @default(LEDIG)
  responsibleUser   User?         @relation("ResponsibleUserMachines", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  responsibleUserId String?
  manualOverrideStatus MachineStatus?
  manualOverrideReason String?
  bookings         MachineBooking[]
  statusLogs       MachineStatusLog[]
  locationHistory  MachineLocationHistory[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}


model MachineBooking {
  id               String        @id @default(cuid())
  machineId        String
  machine          Machine       @relation(fields: [machineId], references: [id], onDelete: Cascade)
  companyId        String
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId        String?
  project          Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  location         String
  startAt          DateTime
  endAt            DateTime
  status           BookingStatus @default(PLANLAGT)
  responsibleUserId String
  responsibleUser  User          @relation("BookingResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  companyName      String?
  comment          String?
  cancelledAt      DateTime?
  cancelledById    String?
  createdById      String
  createdBy        User          @relation("BookingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById      String
  updatedBy        User          @relation("BookingUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  locationHistory  MachineLocationHistory[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([machineId, startAt, endAt])
  @@index([companyId, startAt])
}

model MachineStatusLog {
  id          String       @id @default(cuid())
  machineId   String
  machine     Machine      @relation(fields: [machineId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromStatus  MachineStatus?
  toStatus    MachineStatus
  source      String
  note        String?
  createdById String?
  createdBy   User?        @relation("StatusLogCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())

  @@index([machineId, createdAt])
}

model MachineLocationHistory {
  id          String   @id @default(cuid())
  machineId   String
  machine     Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bookingId   String?
  booking     MachineBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  location    String
  responsibleUserId String?
  responsibleUser User? @relation("LocationResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  note        String?
  createdById String?
  createdBy   User?    @relation("LocationLogCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([machineId, createdAt])
  @@index([companyId, createdAt])
}
