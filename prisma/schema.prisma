generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MachineStatus {
  LEDIG
  TILDELT
  SERVICE
}

enum UserRole {
  ADMIN
  USER
}

model Company {
  id          String      @id @default(cuid())
  name        String      @unique
  orgNumber   String?     @unique
  departments Department[]
  projects    Project[]
  machines    Machine[]
  users       User[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Department {
  id          String    @id @default(cuid())
  name        String
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users       User[]
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([companyId, name])
}

model Project {
  id           String      @id @default(cuid())
  name         String
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  machines     Machine[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([companyId, name])
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  phone        String?
  passwordHash String
  role         UserRole    @default(USER)
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  sessions     Session[]
  machines     Machine[]   @relation("ResponsibleUserMachines")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Machine {
  id                String        @id @default(cuid())
  name              String
  machineNumber     String        @unique
  type              String
  companyId         String
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project           String
  projectId         String?
  projectRef        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  status            MachineStatus @default(LEDIG)
  responsibleUser   User?         @relation("ResponsibleUserMachines", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  responsibleUserId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}
